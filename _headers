# Cloudflare Pages Headers Configuration
# Optimizes caching for static assets and external GitHub images

# Cache HTML for 1 hour (revalidate often)
/*.html
  Cache-Control: public, max-age=3600, must-revalidate

# Cache CSS/JS for 1 year (use versioning for updates)
/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable
  
/service-worker.js
  Content-Type: application/javascript
  Cache-Control: no-cache

# Cache local images aggressively (1 year)
/img/*
  Cache-Control: public, max-age=31536000, immutable

/resources/*
  Cache-Control: public, max-age=31536000, immutable

# Cache JSON data for 1 day (may update)
/*.json
  Cache-Control: public, max-age=86400, must-revalidate

# Set CORS headers for cross-origin images
/*
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN

# Optimize for WebP
/*.webp
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/webp
  
/*.png
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/png

